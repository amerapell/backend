# --- Core -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Railway Postgres: use the service's DATABASE_URL reference variable (${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amerapelle
# Exact origin of the Next.js frontend (CORS is locked to this; also used for payment return URLs and email links).
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins, comma separated (e.g. Vercel preview URLs).
CORS_EXTRA_ORIGINS=

# --- Auth (generate with: openssl rand -base64 48) ----------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- Payments ---------------------------------------------------------
# Paystack secret key (sk_test_… / sk_live_…). Also the webhook HMAC key.
PAYSTACK_SECRET_KEY=
# Bachs API key (sk_sandbox_… / sk_live_…) and webhook signing secret.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# sandbox | live — optional; defaults from the API key prefix.
BACHS_ENV=sandbox
# product (default, per integrations.md: one-off product + product_cart) | pricing (raw amount on the session).
BACHS_CHECKOUT_MODE=product

# --- Email (Resend). Without RESEND_API_KEY emails are logged, not sent. --
RESEND_API_KEY=
MAIL_DOMAIN=amerapelle.com
ADMIN_NOTIFY_EMAIL=orders@amerapelle.com

# --- Admin seed (npm run seed) ------------------------------------------
ADMIN_EMAIL=admin@amerapelle.com
ADMIN_PASSWORD=change-me-strong-password

# --- Cloudinary (signed admin uploads + exchange photos) ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---------------------------------------------------------
SENTRY_DSN=
# PGSSL=true            # force TLS to Postgres (Railway's public proxy URL)
# DISABLE_CRON=true     # disable the stock-hold expiry job (e.g. on a second replica)
# SEED_STORE_ADDRESS="12 Example Street, Victoria Island, Lagos"
# SEED_IMAGE_BASE=https://placehold.co/800x1000/f2f2ef/0a0a0f/png
# SEED_DROP_GO_LIVE=2026-10-14T18:00:00+01:00
# SEED_RESET_ADMIN_PASSWORD=true
